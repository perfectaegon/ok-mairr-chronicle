# --- Required for free self-host (docker compose) ---
# Pick a free DuckDNS name: https://www.duckdns.org
# Example: if you create "okmairr", DOMAIN is okmairr.duckdns.org
DOMAIN=okmairr.duckdns.org
DUCKDNS_TOKEN=
DUCKDNS_SUBDOMAIN=okmairr

# Strong password for /admin (Editor's Desk)
ADMIN_PASSWORD=change-this-password

# --- App ---
HOST=0.0.0.0
PORT=4568
SESSION_HOURS=168
FORCE_SSL=0

# Optional: push posts/uploads to GitHub so content survives redeploys
GITHUB_TOKEN=
GITHUB_REPO=perfectaegon/ok-mairr-chronicle
GITHUB_BRANCH=main
